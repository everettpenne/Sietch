<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Sietch is a file manager, so it can ask for wide access, but only when you turn it on and only for what a feature needs:

      - READ_MEDIA_IMAGES / VIDEO / AUDIO: the Images, Videos and Audio categories, Recents and Search. Asked in context, one prompt.
      - MANAGE_EXTERNAL_STORAGE ("All files access"): browsing every folder, the Documents, Downloads and Apps categories, and the
        recycle bin for ordinary files. Off until you switch it on in Settings; Sietch works, in a reduced way, without it.

      There is no contacts, location, phone, camera, microphone or account access, and no analytics or telemetry.
      The :updater library adds INTERNET and REQUEST_INSTALL_PACKAGES for its "check GitHub releases" feature; that is the app's only
      network use, and it only ever talks to github.com.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Lets Android 14+ offer "select photos and videos" (partial access) instead of treating Sietch as a legacy app. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <application
        android:name=".SietchApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:description="@string/app_description"
        android:category="productivity"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sietch">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press actions: Search and the recycle bin. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Hands one file at a time to another app, read-only, when you tap Open with or Share. Not exported; access is granted per intent. -->
        <provider
            android:name=".SietchFileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
